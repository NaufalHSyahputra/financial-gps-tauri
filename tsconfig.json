{
  "extends": "$app/tsconfig",
  "include": [
    "src",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "#lib": [
        "./src/lib"
      ],
      "#lib/*": [
        "./src/lib/*"
      ]
    }
  },
  "exclude": [
    "src/service-worker",
    "src/service-worker.ts"
  ]
}
